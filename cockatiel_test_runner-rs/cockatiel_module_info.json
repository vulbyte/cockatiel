{
  "name": "cockatiel-test-runner",
  "description": "Compliance & benchmark suite: verifies the pre/in/post message chain against the real engine, then archives results to the timeline.",
  "version": "0.1.0",
  "capabilities": "input",
  "root_file": "./src/main.rs",
  "launch_command": "cargo",
  "command_flags": [
    "run",
    "--release"
  ],
  "autostart": true,
  "terminal": false,
  "binary": {
    "macos": {
      "x86_64": "target/release/cockatiel-test-runner",
      "aarch64": "target/release/cockatiel-test-runner",
      "arm": "target/release/cockatiel-test-runner"
    },
    "linux": {
      "x86_64": "target/release/cockatiel-test-runner",
      "aarch64": "target/release/cockatiel-test-runner",
      "arm": "target/release/cockatiel-test-runner"
    },
    "windows": {
      "x86_64": "target/release/cockatiel-test-runner.exe",
      "aarch64": "target/release/cockatiel-test-runner.exe",
      "arm": "target/release/cockatiel-test-runner.exe"
    }
  },
  "build_command": "cargo",
  "build_flags": [
    "build",
    "--release"
  ]
}