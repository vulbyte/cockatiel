{
  "name": "banned-words",
  "description": "preprocess module that detects and censors banned words (no-spaces, leet, extra-spaces) and can flag messages for review",
  "version": "0.1.0",
  "capabilities": "preprocess",
  "root_file": "./src/main.rs",
  "launch_command": "cargo run",
  "command_flags": ["--release"],
  "autostart": true,
  "credentials": [
    { "key": "banned_words", "label": "Banned Words", "sensitive": false, "list": true },
    { "key": "censor_mode", "label": "Censor Mode (soft/mid/hard/replace/flag)", "sensitive": false, "list": false },
    { "key": "replace_word", "label": "Replacement Word", "sensitive": false, "list": false }
  ]
}